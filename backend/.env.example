# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# "demo" = sample library, no Spotify/Premium/network needed; "real" = Spotify API
SPOTIFY_MODE=real

# Spotify retired audio features for new apps (403 since 2024);
# feature data now comes from this free ReccoBeats endpoint.
RECCOBEATS_BASE_URL=https://api.reccobeats.com

# Database (optional, default SQLite)
DATABASE_URL=sqlite+aiosqlite:///./vibesift.db

# Default AI (optional, user can override in UI)
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.0-flash

# Deployment
FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:8000

# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
